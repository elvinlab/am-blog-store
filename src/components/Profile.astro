---
import config from '@/consts'
---

<div class="shadow-lg rounded-lg w-auto flex flex-col items-center justify-center bg-white/50 dark:bg-[#191B33] p-2 text-textLight dark:text-textDark">
  <img class="avatar mb-4" src={config.$_site.avatarLink} alt="avatar"/>
  <div class="mb-2 text-center text-sm">{config.$_site.description}</div>
  <div class="flex items-center justify-center flex-wrap">
    {
      config.$_socialNetwork.map((sn) => (
        <a title={sn.name} href={sn.outlink} target="_blank">
          <i class={sn.icon + " text-2xl mr-2 cursor-pointer"}/>
        </a>
      ))
    }
  </div>
</div>
